{
  "servers": {
    "layout-suggest": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "npm run --silent suggest:build 1>&2 && exec node out/experiments/layout-suggest/main.js"
      ],
      "cwd": "${workspaceFolder}",
      "dev": {
        "watch": "experiments/layout-suggest/*.{ts,mts,css}"
      }
    }
  }
}
