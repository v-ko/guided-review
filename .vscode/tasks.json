{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Guided Review",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$tsc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Verify Guided Review release",
      "type": "shell",
      "command": "npm run verify:release",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
